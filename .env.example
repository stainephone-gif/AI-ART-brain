# Скопировать в .env и заполнить. Файл .env в git не попадает.
# Значение пишется сразу после знака =, на той же строке ничего больше (без комментариев и кавычек).

# Authorization key из личного кабинета developers.sber.ru (длинная строка base64)
GIGACHAT_CREDENTIALS=

# Telegram (необязательно): токен бота и chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
